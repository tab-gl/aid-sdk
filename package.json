{
  "name": "ace-id-sdk",
  "version": "0.2.5",
  "description": "Official JavaScript/TypeScript SDK for Ace ID (OpenID Connect).",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.js"
      },
      "require": {
        "types": "./dist/server/index.d.cts",
        "default": "./dist/server/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./ui": {
      "import": {
        "types": "./dist/ui/index.d.ts",
        "default": "./dist/ui/index.js"
      },
      "require": {
        "types": "./dist/ui/index.d.cts",
        "default": "./dist/ui/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/oidc-mock.d.ts",
        "default": "./dist/testing/oidc-mock.js"
      },
      "require": {
        "types": "./dist/testing/oidc-mock.d.cts",
        "default": "./dist/testing/oidc-mock.cjs"
      }
    },
    "./diagnostics": {
      "import": {
        "types": "./dist/diagnostics.d.ts",
        "default": "./dist/diagnostics.js"
      },
      "require": {
        "types": "./dist/diagnostics.d.cts",
        "default": "./dist/diagnostics.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "FONT-LICENSE.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsup --config tsup.vanilla.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build && npm run check:bundle && npm run verify:package",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:tarball": "node scripts/verify-installed-tarball.mjs",
    "verify": "npm run build && npm run check:bundle && npm run verify:package"
  },
  "dependencies": {
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "@types/react-test-renderer": "^19.3.1",
    "esbuild": "^0.28.2",
    "linkedom": "0.18.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-test-renderer": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "esbuild": "$esbuild"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "author": "aceyash-dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tab-gl/aid-sdk.git"
  },
  "homepage": "https://github.com/tab-gl/aid-sdk#readme",
  "bugs": {
    "url": "https://github.com/tab-gl/aid-sdk/issues"
  },
  "keywords": [
    "ace-id",
    "openid-connect",
    "oidc",
    "oauth2",
    "authentication",
    "auth-sheet",
    "auth-ui",
    "framework-agnostic",
    "identity",
    "pkce",
    "typescript"
  ]
}
